<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Connectly — Profile</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <!-- ===== Navbar ===== -->
    {{>header}}

    <!-- ===== Profile Page ===== -->
   
    <main class="profile-page">
      <!-- Profile Header -->
      <div class="profile-header">
        <div class="profile-cover">
          <img src=" {{#if user.coverphoto}} {{user.coverphoto}} {{else}}https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTlQ3Ihl2ts7Q8lnpw8f2H8zYUd0k3FdfaJ6CjQ8DEHCcc4mfPGwe2zX3k&s {{/if}}" alt="Cover-pic">
        </div>
        <div class="profile-avatar">
          <div class="avatar-placeholder">
           {{#if user.profilephoto}} <img src="{{user.profilephoto}}" alt=""> {{else}}  {{getInitials user.fullname}} {{/if}}
           </div>
        </div>
        <h1>{{user.fullname}}</h1>
        <p class="profile-username">@{{user.username}}</p>
        <p class="profile-bio">
          {{user.bio}}
        </p>

        <div class="profile-stats-bar">
          <div class="profile-stat">
            <span class="profile-stat-num">{{postCount}}</span>
            <span class="profile-stat-label">Posts</span>
          </div>
          <div class="profile-stat">
            <span class="profile-stat-num">0</span>
            <span class="profile-stat-label">Followers</span>
          </div>
          <div class="profile-stat">
            <span class="profile-stat-num">0</span>
            <span class="profile-stat-label">Following</span>
          </div>
        </div>

        <div class="profile-actions">
          <button class="btn-primary" id="profileFollowBtn">Follow</button>
          {{#if isOwner}}
          <a href="/edit-profile">
            <button class="btn-outline" id="profileEditBtn">Edit Profile</button>
          </a>
           {{/if}}
          <a href="/dashboard" class="btn-outline">Dashboard</a>
        </div>
      </div>

      <!-- Info Cards -->
      <div class="profile-info" style="margin-bottom: var(--space-4);">
        <div class="info-card">
          <span class="info-label">Location</span>
          <span class="info-value">{{user.location}}</span>
        </div>
        <div class="info-card">
          <span class="info-label">Joined</span>
          <span class="info-value">{{timeAgo user.createdAt}}</span>
        </div>
        <div class="info-card">
          <span class="info-label">Website</span>
          <span class="info-value">{{user.website}}</span>
        </div>
        <div class="info-card">
          <span class="info-label">Gender</span>
          <span class="info-value">{{user.gender}}</span>
        </div>
        
      </div>

      <!-- Profile Tabs -->
      <div class="profile-tabs">
        <button
          class="profile-tab active"
          data-tab="posts"
          type="button"
        >Posts</button>
        <button
          class="profile-tab"
          data-tab="about"
          type="button"
        >About</button>
        <button
          class="profile-tab"
          data-tab="saved"
          type="button"
        >Saved</button>
      </div>

      <!-- Tab: Posts -->
      <div class="profile-tab-content active" data-tab="posts">
        {{#if posts.length}}
         <div class="profile-posts-list" id="feedPostsContainer">
          {{#each posts}}
          <article class="post-card-full">
            <div class="post-header">
              <div class="post-avatar">
                {{#if author.profilephoto}} <img src="{{author.profilephoto}}" alt=""> {{else}}  {{getInitials currentuser.fullname}} {{/if}}
              </div>
              <div class="post-header-info">
                <div class="post-header-row">
                  <a href="/profile/{{post._id}}" class="post-author">{{author.fullname}}</a>
                  <span class="post-username">@{{author.username}}</span>
                  <span class="post-audience-tag"> &middot; {{audience}}</span>
                </div>
                <span class="post-time">{{timeAgo createdAt}}</span>
              </div>
              <button
                class="post-options-btn"
                type="button"
                aria-label="Post options"
              >&#8943;</button>
              <div class="post-options-menu">
                <button type="button" class="opt-save">&#128190; Save post</button>
                <button type="button" class="opt-copy">&#128279; Copy link</button>
                <button type="button" class="opt-hide">&#128065; Hide post</button>
                <div class="post-options-divider"></div>
                <button type="button" class="opt-report danger">&#9873; Report
                  post</button>
              </div>
            </div>
            <div class="post-body">
                {{#if content}}
                <p>
                 {{content}}
                </p>
               {{/if}}
              </div>
            <div class="post-image var-1">
                 {{#if mediaUrl}}
              <div class="post-image var-1">
                {{#if (eq mediaType "image")}}
                <img src="{{mediaUrl}}" alt="Post Media">
                {{/if}}

                {{#if (eq mediaType "video")}}
                <video controls>
                  <source src="{{mediaUrl}}" type="video/mp4">
                </video>
                {{/if}}
              </div>
              {{/if}}
              </div>
            <div class="post-stats-row">
              <div class="post-stats-likes">
                <span class="post-like-icons">
                  <span class="post-like-icon heart">&#10084;</span>
                  <span class="post-like-icon thumbs">&#128077;</span>
                </span>
                <span class="like-count">{{likes.length}}</span>
              </div>
              <span class="comment-count-text">{{comment.length}} comments &middot; 8 shares</span>
            </div>
            <div class="post-actions-bar">
              <button class="action-btn like-btn" type="button">
                <span class="action-icon">&#10084;</span>
                Like
              </button>
              <button class="action-btn comment-btn" type="button">
                <span class="action-icon">&#128172;</span>
                Comment
              </button>
              <button class="action-btn share-btn" type="button">
                <span class="action-icon">&#128279;</span>
                Share
              </button>
              <button class="action-btn save-btn" type="button">
                <span class="action-icon">&#128190;</span>
                Save
              </button>
            </div>
            <div class="comments-section">
              <div class="comment-list">
                <div class="comment-empty">No comments yet. Be the first to
                  comment!</div>
              </div>
              <form class="comment-form">
                <div
                  class="comment-avatar"
                  style="background: linear-gradient(135deg, var(--primary), var(--accent));"
                >{{getInitials user.fullname}}</div>
                <input
                  type="text"
                  class="comment-input"
                  placeholder="Write a comment..."
                />
                <button type="submit" class="comment-submit">Post</button>
              </form>
            </div>
          </article>
           {{/each}}

