    <!-- ===== Footer ===== -->
   {{>footer}}

    <script src="js/main.js"></script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
  const success = "{{success}}".trim();
  const error = "{{error}}".trim();

  if (success) {
    Swal.fire({
      title: "Success!",
      text: success,
      icon: "success"
    });
  } else if (error) {
    Swal.fire({
      title: "Error!",
      text: error,
      icon: "error"
    });
  }
  </script>
  </body>
</html>