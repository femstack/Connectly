<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Connectly — Feed</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <!-- ===== Navbar ===== -->
   {{>header}}
    <!-- ===== Full Feed Page ===== -->
    <main class="feed-full">
      <div class="feed-layout">
        <!-- ===== Left Sidebar ===== -->
        <aside class="feed-sidebar-left">
          <!-- Profile Summary -->
          <div class="sidebar-card">
            <div class="sidebar-profile">
              
              <div class="avatar-placeholder">{{#if currentuser.profilephoto}} <img src="{{currentuser.profilephoto}}" alt=""> {{else}}  {{getInitials currentuser.fullname}} {{/if}}</div>
              <h3>{{currentuser.fullname}}</h3>
              <p class="sidebar-username">@{{currentuser.username}}</p>
              <div class="sidebar-profile-stats">
                <div class="sidebar-stat">
                  <span class="sidebar-stat-num">{{userPostCount}}</span>
                  <span class="sidebar-stat-label">Posts</span>
                </div>
                <div class="sidebar-stat">
                  <span class="sidebar-stat-num">1.2K</span>
                  <span class="sidebar-stat-label">Friends</span>
                </div>
                <div class="sidebar-stat">
                  <span class="sidebar-stat-num">856</span>
                  <span class="sidebar-stat-label">Followers</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Navigation Shortcuts -->
          <div class="sidebar-card">
            <nav class="sidebar-nav">
              <a href="/feed" class="active">
                <span class="sidebar-nav-icon">&#128240;</span>
                News Feed
              </a>
              <a href="/dashboard">
                <span class="sidebar-nav-icon">&#128202;</span>
                Dashboard
              </a>
              <a href="/profile/{{currentuser._id}}">
                <span class="sidebar-nav-icon">&#128100;</span>
                My Profile
              </a>
              <a href="#">
                <span class="sidebar-nav-icon">&#128101;</span>
                Friends
              </a>
              <a href="#">
                <span class="sidebar-nav-icon">&#9993;</span>
                Messages
                <span
                  class="nav-badge"
                  style="position:relative;top:0;right:0;margin-left:auto;"
                >3</span>
              </a>
              <a href="#">
                <span class="sidebar-nav-icon">&#128276;</span>
                Notifications
                <span
                  class="nav-badge"
                  style="position:relative;top:0;right:0;margin-left:auto;"
                >5</span>
              </a>
              <a href="#">
                <span class="sidebar-nav-icon">&#128190;</span>
                Saved Posts
              </a>
              <a href="/settings">
                <span class="sidebar-nav-icon">&#9881;</span>
                Settings
              </a>
            </nav>
          </div>
        </aside>

        <!-- ===== Center Feed Column ===== -->
        <section class="feed-main">
          <!-- Feed Header + Tabs -->
          <div class="feed-main-header">
            <h1>Your Feed</h1>
            <div class="feed-tabs">
              <button class="feed-tab active" type="button">All</button>
              <button class="feed-tab" type="button">Friends</button>
              <button class="feed-tab" type="button">Recent</button>
              <button class="feed-tab" type="button">Trending</button>
            </div>
          </div>

          <!-- Stories Row -->
          <div class="stories-row">
            <div class="story-item story-add">
              <div class="story-ring story-add">
                <div class="story-ring-inner">+</div>
              </div>
              <span class="story-name">Add Story</span>
            </div>
            <div class="story-item">
              <div class="story-ring">
                <div class="story-ring-inner">
                  <div class="avatar-placeholder">AS</div>
                </div>
              </div>
              <span class="story-name">Alex Silva</span>
            </div>
            <div class="story-item">
              <div class="story-ring">
                <div class="story-ring-inner">
                  <div class="avatar-placeholder post-avatar-2">MK</div>
                </div>
              </div>
              <span class="story-name">Maya Kapoor</span>
            </div>
            <div class="story-item">
              <div class="story-ring">
                <div class="story-ring-inner">
                  <div class="avatar-placeholder post-avatar-3">JT</div>
                </div>
              </div>
              <span class="story-name">Jordan Tate</span>
            </div>
            <div class="story-item">
              <div class="story-ring">
                <div class="story-ring-inner">
                  <div class="avatar-placeholder post-avatar-4">RL</div>
                </div>
              </div>
              <span class="story-name">Riley Lee</span>
            </div>
            <div class="story-item">
              <div class="story-ring">
                <div class="story-ring-inner">
                  <div class="avatar-placeholder post-avatar-5">EW</div>
                </div>
              </div>
              <span class="story-name">Emma Wilson</span>
            </div>
            <div class="story-item">
              <div class="story-ring">
                <div class="story-ring-inner">
                  <div class="avatar-placeholder post-avatar-6">CM</div>
                </div>
              </div>
              <span class="story-name">Carlos Mendez</span>
            </div>
          </div>

          <!-- Post Composer -->
          <div class="post-composer">
            <div class="composer-top">
              <div class="composer-avatar">JD</div>
              <textarea
                class="composer-textarea"
                id="composerTextarea"
                placeholder="What's on your mind, Jane?"
                maxlength="500"
              ></textarea>
            </div>

            <div class="composer-attached" id="composerAttached">
              <span>&#128247; photo_selected.jpg</span>
              <button
                class="remove-attach"
                id="composerRemoveAttach"
                type="button"
              >&times;</button>
            </div>

            <div class="composer-bottom">
              <div class="composer-tools">
                <button
                  class="composer-tool"
                  id="composerAttachBtn"
                  type="button"
                >
                  <span class="composer-tool-icon">&#128247;</span>
                  Photo
                </button>
                <button
                  class="composer-tool"
                  type="button"
                  onclick="return false;"
                >
                  <span class="composer-tool-icon">&#127909;</span>
                  Video
                </button>
                <button
                  class="composer-tool"
                  type="button"
                  onclick="return false;"
                >
                  <span class="composer-tool-icon">&#128526;</span>
                  Feeling
                </button>
              </div>
              <div class="composer-audience">
                <select class="audience-select" id="composerAudience">
                  <option value="Public">&#127760; Public</option>
                  <option value="Friends">&#128101; Friends</option>
                  <option value="Only Me">&#128274; Only Me</option>
                </select>
                <button
                  class="btn-primary composer-submit"
                  id="composerPostBtn"
                  type="button"
                >
                  Post
                </button>
              </div>
            </div>

            <div class="composer-feedback" id="composerFeedback"></div>
          </div>

          <!-- Feed Posts -->
          <div id="feedPostsContainer">
            <!-- Post 1 -->
            {{#if posts.length}}

            {{#each posts}}
            <article class="post-card-full">
              <div class="post-header">
                <div class="post-avatar">{{#if author.profilephoto}} <img src="{{ author.profilephoto}}" alt=""> {{else}}  {{getInitials author.fullname}} {{/if}}</div>
                <div class="post-header-info">
                  <div class="post-header-row">
                    <a href="/profile/{{author._id}}" class="post-author">{{author.fullname}}</a>
                    <span class="post-username">@{{author.username}}</span>
                    <span class="post-audience-tag">&middot; {{audience}}</span>
                  </div>
                  <span class="post-time">{{timeAgo createdAt}}</span>
                </div>
                <button
                  class="post-options-btn"
                  type="button"
                  aria-label="Post options"
                >&#8943;</button>
                <div class="post-options-menu">
                  <button type="button" class="opt-save">&#128190; Save post</button>
                  <button type="button" class="opt-copy">&#128279; Copy link</button>
                  <button type="button" class="opt-hide">&#128065; Hide post</button>
                  <div class="post-options-divider"></div>
                  <button type="button" class="opt-report danger">&#9873; Report
                    post</button>
                </div>
              </div>
              <a href="/post/{{_id}}">
                <div class="post-body">
               {{#if content}}
                <p>
                 {{content}}
                </p>
               {{/if}}
              </div>
                {{#if mediaUrl}}
              <div class="post-image var-1">
                {{#if (eq mediaType "image")}}
                <img src="{{mediaUrl}}" alt="Post Media">
                {{/if}}

                {{#if (eq mediaType "video")}}
                <video controls>
                  <source src="{{mediaUrl}}" type="video/mp4">
                </video>
                {{/if}}
              </div>
              {{/if}}
              </a>
              <div class="post-stats-row">
                <div class="post-stats-likes">
                  <span class="post-like-icons">
                    <span class="post-like-icon heart">&#10084;</span>
                    <span class="post-like-icon thumbs">&#128077;</span>
                  </span>
                  <span class="like-count">{{likeCount}}</span>
                </div>
                <span class="comment-count-text">{{comment.length}} comment &middot; 5 shares</span>
              </div>
              <div class="post-actions-bar">
                <button class="action-btn like-btn {{#if isLiked}}liked{{/if}}" type="button" data-post-id="{{_id}}" >
                  <span class="action-icon">&#10084;</span>
                  {{#if isLiked}}liked{{else}}Like{{/if}}
                </button>
                <button class="action-btn comment-btn" type="button">
                  <span class="action-icon">&#128172;</span>
                  Comment
                </button>
                <button class="action-btn share-btn" type="button" >
                  <span class="action-icon">&#128279;</span>
                  Share
                </button>
                <button class="action-btn save-btn {{#if isSaved}} Saved{{/if}}" type="button" data-post-id="{{_id}}">
                  <span class="action-icon">&#128190;</span>
                  {{#if isSaved}} Saved {{else}}Save {{/if}}
                </button>
              </div>
              <div class="comments-section">
                <div class="comment-list">
                  {{#each post.comment}}
                  <div class="comment-item">
                    <div class="comment-avatar post-avatar-2">{{initials}}</div>
                    <div class="comment-body">
                      <div class="comment-meta">
                        <span class="comment-author">{{author.name}}</span>
                        <span class="comment-time">{{timeAgo}}</span>
                      </div>
                      <p class="comment-text">{{text}}</p>
                      <div class="comment-actions">
                        <button
                          class="comment-action"
                          type="button"
                        >Like</button>
                        <button
                          class="comment-action"
                          type="button"
                        >Reply</button>
                      </div>
                    </div>
                  </div>
                  {{/each}}
                  {{!-- <div class="comment-item">
                    <div class="comment-avatar post-avatar-3">JT</div>
                    <div class="comment-body">
                      <div class="comment-meta">
                        <span class="comment-author">Jordan Tate</span>
                        <span class="comment-time">45 min ago</span>
                      </div>
                      <p class="comment-text">Adding this to my reading list
                        right now. Thanks for the recommendation!</p>
                      <div class="comment-actions">
                        <button
                          class="comment-action"
                          type="button"
                        >Like</button>
                        <button
                          class="comment-action"
                          type="button"
                        >Reply</button>
                      </div>
                    </div>
                  </div> --}}
                </div>
                <form class="comment-form" method="post" action="/posts/{{_id}}/comment" >
                  <div
                    class="comment-avatar"
                    style="background: linear-gradient(135deg, var(--primary), var(--accent));"
                  >{{initials}}</div>
                  <input
                    type="text"
                    name="text"
                    class="comment-input"
                    placeholder="Write a comment..."
                  />

                  <input
                    type="hidden"
                    name="returnTo"
                    value="/feed"
                    placeholder="Write a comment..."
                  />

                  <button type="submit" class="comment-submit">Post</button>
                </form>
              </div>
            </article>
            {{/each}}

            {{else}}
            <h3>No Post Yet</h3>
            {{/if}}

