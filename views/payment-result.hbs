<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Payment Result | Connectly</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    {{>header}}

    <main class="payment-result-page">

        <div class="payment-result-card">

            {{#if paymentSuccess}}

                <div class="payment-result-icon success-icon">
                    ✓
                </div>

                <h1>Payment Successful!</h1>

                <p>
                    Your payment has been verified successfully.
                    Welcome to Connectly Premium!
                </p>

                <div class="payment-result-details">

                    <div>
                        <span>Plan</span>
                        <strong>Annual Premium</strong>
                    </div>

                    <div>
                        <span>Amount Paid</span>
                        <strong>₦{{amount}}</strong>
                    </div>

                    <div>
                        <span>Transaction Reference</span>
                        <strong>{{reference}}</strong>
                    </div>

                </div>

                <a href="/premium" class="btn-primary">
                    Go to Premium
                </a>

            {{else}}

                <div class="payment-result-icon failure-icon">
                    !
                </div>

                <h1>Payment Not Confirmed</h1>

                <p>
                    {{message}}
                </p>

                <p>
                    If money was deducted from your account,
                    please check your payment history before
                    trying again.
                </p>

                <a href="/payment-history" class="btn-primary">
                    View Payment History
                </a>

                <a href="/checkout" class="btn-secondary">
                    Return to Checkout
                </a>

            {{/if}}

        </div>

    </main>

    {{>footer}}

</body>
</html>