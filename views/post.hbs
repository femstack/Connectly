<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{pageTitle}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <!-- ===== Navbar ===== -->
    {{>header}}

    <!-- ===== Post Detail Page ===== -->
    <main class="post-detail-page">
      <div class="post-detail-container">
        <a href="/feed" class="pd-back-link">&#8592; Back to Feed</a>

        <div class="post-detail-layout">
          <!-- Main Post Column -->
          <div class="pd-main">
            <article class="post-card-full">
              <div class="post-header">
                <div class="post-avatar">{{getInitials post.author.fullname}}</div>
                <div class="post-header-info">
                  <div class="post-header-row">
                    <a href="/profile/{{post._id}}" class="post-author">{{post.author.fullname}}</a>
                    <span class="post-username">@{{post.author.username}}</span>
                    <span class="post-audience-tag">&middot; {{post.audience}}</span>
                  </div>
                  <span class="post-time">{{timeAgo post.createdAt}}</span>
                </div>
                <button
                  class="post-options-btn"
                  type="button"
                  aria-label="Post options"
                >&#8943;</button>
                <div class="post-options-menu">
                  <button type="button" class="opt-save">&#128190; Save post</button>
                  <button type="button" class="opt-copy">&#128279; Copy link</button>
                  <button type="button" class="opt-hide">&#128065; Hide post</button>
                  <div class="post-options-divider"></div>
                  <button type="button" class="opt-report danger">&#9873; Report
                    post</button>
                </div>
              </div>
              <div class="post-body">
                {{#if post.content}}
                <p>
                 {{post.content}}
                </p>
               {{/if}}
              </div>
              <div class="post-image var-1">
                 {{#if post.mediaUrl}}
              <div class="post-image var-1">
                {{#if (eq post.mediaType "image")}}
                <img src="{{post.mediaUrl}}" alt="Post Media">
                {{/if}}

                {{#if (eq post.mediaType "video")}}
                <video controls>
                  <source src="{{post.mediaUrl}}" type="video/mp4">
                </video>
                {{/if}}
              </div>
              {{/if}}
              </div>
              <div class="post-stats-row">
                <div class="post-stats-likes">
                  <span class="post-like-icons">
                    <span class="post-like-icon heart">&#10084;</span>
                    <span class="post-like-icon thumbs">&#128077;</span>
                  </span>
                  <span class="like-count">{{post.likeCount}} likes</span>
                </div>
                <span class="comment-count-text">{{post.commentCount}} comments &middot; 0 shares</span>
              </div>
              <div class="post-actions-bar">
                <form action="/post/{{post._id}}/like" method="post">
                  <button class="action-btn like-btn" type="submit">
                 &#10084; {{#if post.isliked}}Unliked{{else}}{{/if}}
                  Like
                </button>
                </form>
                <button class="action-btn comment-btn" type="button">
                  <span class="action-icon">&#128172;</span>
                  Comment
                </button>
                <button class="action-btn share-btn" type="button">
                  <span class="action-icon">&#128279;</span>
                  Share
                </button>
               <form action="/post/{{post._id}}/save" method="POST">
  <button class="action-btn save-btn" type="submit">
    <span class="action-icon">&#128190;</span>
    {{#if post.isSaved}}
      Unsave
    {{else}}
      Save
    {{/if}}
  </button>
</form>
              </div>
              <div class="comments-section open">
                <div class="comments-section-header">
                  <h3>{{post.commentCount}} Comments</h3>
                  <select class="comment-sort-select">
                    <option >Most relevant</option>
                    <option>Newest first</option>
                    <option>Oldest first</option>
                  </select>
                </div>
                <div class="comment-list">
                  {{#each post.comment}} 
                  <div class="comment-item">
                    <div class="comment-avatar post-avatar-2">{{getInitials author.fullname}}</div>
                    <div class="comment-body">
                      <div class="comment-meta">
                        <span class="comment-author">{{author.fullname}}</span>
                        <span class="comment-time">{{timeAgo createdAt}}</span>
                      </div>
                      <p class="comment-text">{{text}}</p>
                      <div class="comment-actions">
                        <button
                          class="comment-action"
                          type="button"
                        >Like</button>
                        <button
                          class="comment-action"
                          type="button"
                        >Reply</button>
                      </div>
                    </div>
                  </div>
                  {{else}} 
                  <p>
                    No Comments yet. Be the first to comment
                  </p>
                  {{/each}}
