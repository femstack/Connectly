                </div>
                <form class="comment-form" method="post" action="/post/{{post._id}}/comment">
                  <div
                    class="comment-avatar"
                    style="background: linear-gradient(135deg, var(--primary), var(--accent));"
                  >{{getInitials currentuser.fullname}}</div>
                  <input
                    type="text"
                    name="text"
                    class="comment-input"
                    placeholder="Write a comment..."
                    maxlength="2000"
                    required
                  />
                  <button type="submit" class="comment-submit">Post</button>
                </form>
              </div>
            </article>
          </div>

          <!-- Sidebar -->
          <aside class="pd-sidebar">
            <div class="sidebar-card">
              <h3>Post Details</h3>
              <div class="pd-info-list">
                <div class="pd-info-row">
                  <span class="pd-info-label">&#128338; Posted</span>
                  <span class="pd-info-value">{{timeAgo post.createdAt}}</span>
                </div>
                <div class="pd-info-row">
                  <span class="pd-info-label">&#127760; Audience</span>
                  <span class="pd-info-value">{{post.audience}}</span>
                </div>
                <div class="pd-info-row">
                  <span class="pd-info-label">&#128065; Views</span>
                  <span class="pd-info-value">0</span>
                </div>
                <div class="pd-info-row">
                  <span class="pd-info-label">&#10084; Likes</span>
                  <span class="pd-info-value">{{post.likeCount}}</span>
                </div>
                <div class="pd-info-row">
                  <span class="pd-info-label">&#128172; Comments</span>
                  <span class="pd-info-value">{{post.commentCount}}</span>
                </div>
                <div class="pd-info-row">
                  <span class="pd-info-label">&#128279; Save</span>
                  <span class="pd-info-value">{{post.saveCount}}</span>
                </div>
              </div>
            </div>

            <div class="sidebar-card">
              <h3>Related Posts</h3>
              <div class="pd-related-list">
                <a href="/post/{{_id}}" class="pd-related-item">
                  <div class="pd-related-icon">&#128214;</div>
                  <div class="pd-related-info">
                    <span class="pd-related-title">10 design books every
                      developer should read</span>
                    <span class="pd-related-meta">Jordan Tate &middot; 89 likes</span>
                  </div>
                </a>
                <a href="/post/{{_id}}" class="pd-related-item">
                  <div class="pd-related-icon">&#127912;</div>
                  <div class="pd-related-info">
                    <span class="pd-related-title">Building a design system from
                      scratch</span>
                    <span class="pd-related-meta">Emma Wilson &middot; 145 likes</span>
                  </div>
                </a>
                <a href="/post/{{_id}}" class="pd-related-item">
                  <div class="pd-related-icon">&#128221;</div>
                  <div class="pd-related-info">
                    <span class="pd-related-title">Design tokens: the complete
                      guide</span>
                    <span class="pd-related-meta">Carlos Mendez &middot; 67
                      likes</span>
                  </div>
                </a>
              </div>
            </div>

            <div class="sidebar-card">
              <h3>People Who Engaged</h3>
              <div class="pd-engaged-list">
                <div class="suggest-item">
                  <div class="suggest-avatar post-avatar-2">MK</div>
                  <div class="suggest-info">
                    <div class="suggest-name">Maya Kapoor</div>
                    <div class="suggest-meta">Liked &amp; commented</div>
                  </div>
                  <button class="suggest-btn" type="button">Follow</button>
                </div>
                <div class="suggest-item">
                  <div class="suggest-avatar post-avatar-3">JT</div>
                  <div class="suggest-info">
                    <div class="suggest-name">Jordan Tate</div>
                    <div class="suggest-meta">Liked &amp; commented</div>
                  </div>
                  <button class="suggest-btn" type="button">Follow</button>
                </div>
                <div class="suggest-item">
                  <div class="suggest-avatar post-avatar-6">CM</div>
                  <div class="suggest-info">
                    <div class="suggest-name">Carlos Mendez</div>
