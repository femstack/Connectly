<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Payment History | Connectly</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    {{>header}}

    <main class="payment-history-page">

        <div class="payment-history-container">

            <div class="payment-history-heading">

                <div>
                    <h1>Payment History</h1>

                    <p>
                        View your Connectly Premium transactions.
                    </p>
                </div>

                <a href="/premium" class="btn-secondary">
                    Back to Premium
                </a>

            </div>

            <section class="payment-history-summary">

                <div class="history-summary-card">
                    <span>Total Transactions</span>
                    <strong>{{totalPayments}}</strong>
                </div>

                <div class="history-summary-card">
                    <span>Successful Payments</span>
                    <strong>{{successfulPayments}}</strong>
                </div>

                {{!-- <div class="history-summary-card">
                    <span>Total Paid</span>
                    <strong>₦{{totalPaid}}</strong>
                </div> --}}

            </section>

            {{#if payments.length}}

                <div class="payment-table-wrapper">

                    <table class="payment-history-table">

                        <thead>
                            <tr>
                                <th>Plan</th>
                                <th>Amount</th>
                                <th>Date</th>
                                <th>Reference</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            {{#each payments}}

                                <tr>

                                    <td>
                                        {{#if (eq plan "annual")}}
                                            Annual Premium
                                        {{else}}
                                            {{plan}}
                                        {{/if}}
                                    </td>

                                    <td>
                                        ₦{{displayAmount}}
                                    </td>

                                    <td>
                                        {{displayDate}}
                                    </td>

                                    <td class="payment-reference">
                                        {{reference}}
                                    </td>

                                    <td>
                                        <span class="payment-status status-{{status}}">
                                            {{status}}
                                        </span>
                                    </td>

                                </tr>

                            {{/each}}

                        </tbody>

                    </table>

                </div>

            {{else}}

                <div class="empty-payment-history">

                    <h2>No payments yet</h2>

                    <p>
                        Your Connectly payment transactions
                        will appear here after you make a payment.
                    </p>

                    <a href="/checkout" class="btn-primary">
                        Upgrade to Premium
                    </a>

                </div>

            {{/if}}

        </div>

    </main>

    {{>footer}}

</body>
</html>