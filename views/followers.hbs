    <main class="connections-page">
      <div class="connections-container">
        <div class="connections-header">
          <h1>Connections</h1>
          <p>Manage your followers, following, and friends.</p>
        </div>

        <div class="connections-stats">
          <a href="followers.html" class="conn-stat-card active">
            <span class="conn-stat-num">856</span>
            <span class="conn-stat-label">Followers</span>
          </a>
          <a href="followers.html" class="conn-stat-card">
            <span class="conn-stat-num">423</span>
            <span class="conn-stat-label">Following</span>
          </a>
          <a href="followers.html" class="conn-stat-card">
            <span class="conn-stat-num">1,247</span>
            <span class="conn-stat-label">Friends</span>
          </a>
        </div>

        <div class="conn-tabs-bar">
          <button
            class="feed-tab active conn-tab-btn"
            type="button"
            data-tab="followers"
          >Followers</button>
          <button
            class="feed-tab conn-tab-btn"
            type="button"
            data-tab="following"
          >Following</button>
          <button
            class="feed-tab conn-tab-btn"
            type="button"
            data-tab="friends"
          >Friends</button>
          <div class="conn-search-box">
            <span class="nav-search-icon">&#128269;</span>
            <input
              type="text"
              placeholder="Search connections..."
              class="conn-search-input"
            />
          </div>
        </div>

