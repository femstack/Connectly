<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Connectly — Connect. Share. Discover.</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="css/style.css" />
    <meta property="og:image" content="https://bolt.new/static/og_default.png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="https://bolt.new/static/og_default.png">
</head>
  <body>
    <!-- ===== Navbar ===== -->
{{>header}}

    <!-- ===== Hero Section ===== -->
    <section class="hero">
      <div class="hero-content">
        <h1>Connect with people who share your passions.</h1>
        <p>
          Connectly is a modern social platform built for meaningful
          conversations, real communities, and genuine connections. Join the
          conversation today.
        </p>
        <div class="hero-buttons">
          <a href="/register" class="btn-primary btn-lg">Get Started</a>
          <a href="/login" class="btn-outline btn-lg">Login</a>
        </div>
      </div>
    </section>

    <!-- ===== Stats Strip ===== -->
    <section class="stats-strip">
      <div class="stats-strip-container">
        <div class="stats-strip-item">
          <span class="stats-strip-num">50K+</span>
          <span class="stats-strip-label">Active Users</span>
        </div>
        <div class="stats-strip-item">
          <span class="stats-strip-num">1.2M+</span>
          <span class="stats-strip-label">Posts Shared</span>
        </div>
        <div class="stats-strip-item">
          <span class="stats-strip-num">340+</span>
          <span class="stats-strip-label">Communities</span>
        </div>
        <div class="stats-strip-item">
          <span class="stats-strip-num">98%</span>
          <span class="stats-strip-label">Satisfaction</span>
        </div>
      </div>
    </section>

    <!-- ===== Features Section ===== -->
    <section class="features">
      <div class="section-header">
        <h2>Why Connectly?</h2>
        <p>Everything you need to build and grow your community.</p>
      </div>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">&#128172;</div>
          <h3>Real Conversations</h3>
          <p>
            Share thoughts, start discussions, and engage with people who care
            about what you have to say.
          </p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">&#129309;</div>
          <h3>Build Communities</h3>
          <p>
            Create or join groups around your interests and connect with
            like-minded individuals.
          </p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">&#128274;</div>
          <h3>Privacy First</h3>
          <p>
            Your data stays yours. We put privacy and control at the center of
            everything we build.
          </p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">&#128247;</div>
          <h3>Share Moments</h3>
          <p>
            Post photos, stories, and updates. Share your life with the people
            who matter most.
          </p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">&#128202;</div>
          <h3>Track Engagement</h3>
          <p>
            Monitor your growth with a personal dashboard. See likes, comments,
            and follower trends at a glance.
          </p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">&#127881;</div>
          <h3>Stay Connected</h3>
          <p>
            Get instant notifications for likes, comments, and new followers so
            you never miss a moment.
          </p>
        </div>
      </div>
    </section>

    <!-- ===== How It Works Section ===== -->
    <section class="how-it-works">
      <div class="section-header">
        <h2>How It Works</h2>
        <p>Get started in three simple steps.</p>
      </div>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-number">1</div>
          <h3>Create Your Account</h3>
          <p>
            Sign up in seconds with your email. Pick a username, add a photo,
            and write a short bio to introduce yourself.
          </p>
        </div>
        <div class="step-card">
          <div class="step-number">2</div>
          <h3>Find Your People</h3>
          <p>
            Discover friends, join communities, and follow people who share
            your interests. Your feed is tailored to what you love.
          </p>
        </div>
        <div class="step-card">
          <div class="step-number">3</div>
          <h3>Share &amp; Engage</h3>
          <p>
            Post updates, share photos, start conversations, and react to what
            others are sharing. Build your presence and grow your network.
          </p>
        </div>
      </div>
    </section>

    <!-- ===== Testimonials Section ===== -->
    <section class="testimonials">
      <div class="section-header">
        <h2>Loved by Our Community</h2>
        <p>Hear what people are saying about Connectly.</p>
      </div>
      <div class="testimonials-grid">
        <div class="testimonial-card">
          <div class="testimonial-rating">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <p class="testimonial-text">
            "Connectly completely changed how I interact online. The
            conversations feel genuine and the community is so welcoming. I've
            met people I never would have connected with otherwise."
          </p>
          <div class="testimonial-author">
            <div class="testimonial-avatar post-avatar-2">MK</div>
            <div class="testimonial-author-info">
              <span class="testimonial-name">Maya Kapoor</span>
              <span class="testimonial-role">Photographer</span>
            </div>
          </div>
        </div>
        <div class="testimonial-card">
          <div class="testimonial-rating">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <p class="testimonial-text">
            "As a designer, I was looking for a platform where I could share my
            work and get real feedback. Connectly gave me that and so much more.
            The engagement dashboard is a game changer."
          </p>
          <div class="testimonial-author">
            <div class="testimonial-avatar post-avatar-3">JT</div>
            <div class="testimonial-author-info">
              <span class="testimonial-name">Jordan Tate</span>
              <span class="testimonial-role">UI Designer</span>
            </div>
          </div>
        </div>
        <div class="testimonial-card">
          <div class="testimonial-rating">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <p class="testimonial-text">
            "The privacy controls on Connectly are unmatched. I decide exactly
            who sees my posts and who can contact me. It's social media done
            right."
          </p>
          <div class="testimonial-author">
            <div class="testimonial-avatar post-avatar-4">RL</div>
            <div class="testimonial-author-info">
              <span class="testimonial-name">Riley Lee</span>
              <span class="testimonial-role">Software Engineer</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== CTA Section ===== -->
    <section class="cta-section">
      <div class="cta-content">
        <h2>Ready to join the conversation?</h2>
        <p>
          Create your free account today and start connecting with people who
          share your passions. It only takes a minute.
        </p>
        <div class="hero-buttons">
          <a href="/register" class="btn-primary btn-lg">Get Started Free</a>
          <a href="/login" class="btn-outline btn-lg">Login</a>
        </div>
      </div>
    </section>

    <!-- ===== Footer ===== -->
{{>footer}}
    <script type="module" src="js/main.js"></script>
  </body>
</html>
