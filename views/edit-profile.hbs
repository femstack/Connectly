        <!-- Danger Zone -->
        <div class="form-section danger-zone">
          <h2 class="form-section-title">Danger Zone</h2>
          <p class="form-section-hint">These actions are permanent and cannot be
            undone.</p>

          <div class="danger-item">
            <div class="danger-item-info">
              <strong>Deactivate account</strong>
              <p>Temporarily disable your account. Your profile and posts will
                be hidden until you log back in.</p>
            </div>
            <button
              type="button"
              class="btn-outline btn-sm"
              id="deactivateAccountBtn"
            >Deactivate</button>
          </div>

          <div class="danger-item">
            <div class="danger-item-info">
              <strong>Delete account</strong>
              <p>Permanently delete your account, all posts, comments, and data.
                This cannot be undone.</p>
            </div>
            <button
              type="button"
              class="btn-danger btn-sm"
              id="deleteAccountBtn"
            >Delete Account</button>
          </div>
        </div>

        <!-- Form Actions -->
        <div class="form-actions">
          <button type="submit" class="btn-primary btn-lg">Save Changes</button>
          <a
            href="profile.html"
            class="btn-outline btn-lg"
            id="cancelEdit"
          >Cancel</a>
        </div>

        <div class="form-feedback" id="editProfileFeedback"></div>
