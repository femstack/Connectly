    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Connectly — Edit Profile</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <style>
    
.validation-errors {
  background: #fff0f0;
  color: #b42318;
  border: 1px solid #f5b7b1;
  border-radius: 8px;
  padding: 12px 16px;
  margin-bottom: 16px;
   font-size: 13px;
}

.validation-errors p {
  font-weight:500;
  margin-top: 0;
}

.validation-errors ul {
  margin-bottom: 0;
  padding-left: 20px;
}

.validation-errors li {
  margin: 5px 0;
}

  </style>
  <body>
    <!-- ===== Navbar ===== -->
    {{>header}}

    <!-- ===== Edit Profile Page ===== -->
    <main class="edit-profile-page">
      <div class="edit-profile-header">
        <h1>Edit Profile</h1>
        <p>Update your personal information, profile photo, and cover image.</p>
      </div>

      <form
        id="editProfileForm"
        class="edit-profile-form"
        action="/edit-profile"
        method="POST"
        enctype="multipart/form-data"
      >
        <!-- Cover Image Upload -->
        <div class="form-section">
          <h2 class="form-section-title">Cover Image</h2>
          <div class="cover-preview-wrapper">
            <div class="image-preview cover-preview" id="coverPreview">
              <img
                src="https://images.pexels.com/photos/1597401/pexels-photo-1597401.jpeg?auto=compress&cs=tinysrgb&w=1200"
                alt="Current cover photo"
                class="preview-img cover-preview-img"
                id="coverPreviewImg"
              />
              <div class="preview-overlay">
                <span>Click to change cover</span>
              </div>
            </div>
            <input
              type="file"
              id="coverInput"
              name="cover"
              accept="image/png, image/jpeg, image/webp"
              class="hidden-file-input"
              aria-label="Upload cover image"
            />
            <label for="coverInput" class="btn-outline btn-sm">Choose Cover
              Photo</label>
            <button
              type="button"
              class="btn-text btn-sm"
              id="removeCover"
            >Remove</button>
          </div>
        </div>

        <!-- Profile Photo Upload -->
        <div class="form-section">
          <h2 class="form-section-title">Profile Photo</h2>
          <div class="avatar-preview-wrapper">
            <div class="image-preview avatar-preview" id="avatarPreview">
              <img
                src="https://images.pexels.com/photos/220453/pexels-photo-220453.jpeg?auto=compress&cs=tinysrgb&w=400"
                alt="Current profile photo"
                class="preview-img avatar-preview-img"
                id="avatarPreviewImg"
              />
              <div class="preview-overlay">
                <span>Change</span>
              </div>
            </div>
            <input
              type="file"
              id="avatarInput"
              name="avatar"
              accept="image/png, image/jpeg, image/webp"
              class="hidden-file-input"
              aria-label="Upload profile photo"
            />
            <div class="avatar-actions">
              <label for="avatarInput" class="btn-outline btn-sm">Choose Photo</label>
              <button
                type="button"
                class="btn-text btn-sm"
                id="removeAvatar"
              >Remove</button>
            </div>
          </div>
        </div>

        <!-- Basic Information -->
        <div class="form-section">
          <h2 class="form-section-title">Basic Information</h2>

          <div class="form-row">
            <div class="form-group">
              <label for="firstName">First Name</label>
              <input
                type="text"
                id="firstName"
                name="firstname"
                value="{{user.firstname}}"
                placeholder="First name"
                required
              />
            </div>
            <div class="form-group">
              <label for="lastName">Last Name</label>
              <input
                type="text"
                id="lastName"
                name="lastname"
                value="{{user.lastname}}"
                placeholder="Last name"
                required
              />
            </div>
          </div>

          <div class="form-group">
            <label for="username">Username</label>
            <input
              type="text"
              id="username"
              name="username"
              value="{{user.username}}"
              placeholder="Choose a unique username"
              required
            />
          </div>

          <div class="form-group">
            <label for="email">Email Address</label>
            <input
              type="email"
              id="email"
              name="email"
              value="{{user.email}}"
              placeholder="you@example.com"
              required
            />
          </div>

          <div class="form-group">
            <label for="bio">Bio</label>
            <textarea
              id="bio"
              name="bio"
              rows="4"
              maxlength="160"
              placeholder="Tell people a little about yourself..."
            >{{user.bio}}</textarea>
            <div class="char-counter">
              <span id="bioCounter">118</span>
              / 160 characters
            </div>
          </div>
        </div>

        <!-- Additional Details -->
        <div class="form-section">
          <h2 class="form-section-title">Additional Details</h2>

          <div class="form-row">
            <div class="form-group">
              <label for="location">Location</label>
              <input
                type="text"
                id="location"
                name="location"
                value="{{user.location}}"
                placeholder="City, State"
              />
            </div>
            <div class="form-group">
              <label for="website">Website</label>
              <input
                type="url"
                id="website"
                name="website"
                value="{{user.website}}"
                placeholder="https://your-website.com"
              />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="dob">Date of Birth</label>
              <input type="date" id="dob" name="dob" value="{{dobInput}}" />
            </div>
            <div class="form-group">
              <label for="gender">Gender</label>
              <select id="gender" name="gender">
                <option value="">Select gender (optional)</option>
                <option value="female" {{#if (eq user.gender "female")}}selected{{/if}}>Female</option>
                <option value="male" {{#if (eq user.gender "male")}}selected{{/if}}>Male</option>
                {{!-- <option value="nonbinary">Non-binary</option>
                <option value="other">Other</option>
                <option value="prefer-not">Prefer not to say</option> --}}
              </select>
            </div>
          </div>

          {{!-- <div class="form-group">
            <label for="pronouns">Pronouns</label>
