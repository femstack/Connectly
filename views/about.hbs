<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Connectly — About</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <!-- ===== Navbar ===== -->
  {{>header}}

    <!-- ===== About Page ===== -->
    <main class="about-page">
      <section class="about-hero">
        <h1>About Connectly</h1>
        <p>
          Connectly is a modern social media platform designed to bring people
          together through meaningful conversations and shared interests. We
          believe social media should feel human &mdash; not overwhelming.
        </p>
      </section>

      <section class="about-mission">
        <div class="section-header">
          <h2>Our Mission</h2>
          <p>
            To create a space where people can connect authentically, share
            ideas freely, and build communities that matter &mdash; without the noise,
            without the pressure.
          </p>
        </div>
      </section>

      <section class="features">
        <div class="section-header">
          <h2>What You'll Be Able to Do</h2>
          <p>Here's a look at what's coming to Connectly.</p>
        </div>
        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon">&#128100;</div>
            <h3>Create Your Profile</h3>
            <p>
              Set up your personal profile, share a bio, and let people know who
              you are.
            </p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">&#9999;</div>
            <h3>Share Posts</h3>
            <p>
              Express yourself through posts, share updates, and start
              conversations with your network.
            </p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">&#129309;</div>
            <h3>Connect with Others</h3>
            <p>
              Follow people, build connections, and grow your community around
              shared interests.
            </p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">&#128172;</div>
            <h3>Join Discussions</h3>
            <p>
              Comment on posts, reply to others, and take part in conversations
              that matter to you.
            </p>
          </div>
        </div>
      </section>

      <!-- ===== Values ===== -->
      <section class="about-values">
        <div class="section-header">
          <h2>Our Values</h2>
          <p>The principles that guide everything we build.</p>
        </div>
        <div class="values-grid">
          <div class="value-card">
            <div class="value-icon">&#128274;</div>
            <h3>Privacy by Default</h3>
            <p>
              We believe your data belongs to you. Every feature is designed with
              privacy as the starting point, not an afterthought.
            </p>
          </div>
          <div class="value-card">
            <div class="value-icon">&#129505;</div>
            <h3>Authentic Connection</h3>
            <p>
              We optimize for meaningful interactions, not endless scrolling.
              Quality over quantity, always.
            </p>
          </div>
          <div class="value-card">
            <div class="value-icon">&#127760;</div>
            <h3>Open Community</h3>
            <p>
              Everyone deserves a seat at the table. We build for inclusivity,
              diversity, and respect across every corner of our platform.
            </p>
          </div>
        </div>
      </section>

      <!-- ===== Team ===== -->
      <section class="about-team">
        <div class="section-header">
          <h2>Meet the Team</h2>
          <p>The people behind Connectly.</p>
        </div>
        <div class="team-grid">
          <div class="team-member">
            <div class="team-avatar post-avatar-2">AK</div>
            <h3>Aisha Khan</h3>
            <p class="team-role">Founder &amp; CEO</p>
            <p class="team-bio">
              Aisha started Connectly after years of frustration with the state
              of social media. She believes technology should bring us closer,
              not drive us apart.
            </p>
          </div>
          <div class="team-member">
            <div class="team-avatar post-avatar-3">MS</div>
            <h3>Marcus Silva</h3>
            <p class="team-role">Head of Engineering</p>
            <p class="team-bio">
              Marcus leads our engineering team with a passion for clean,
              scalable architecture. He's obsessed with making things fast and
              reliable.
            </p>
          </div>
          <div class="team-member">
            <div class="team-avatar post-avatar-4">EN</div>
            <h3>Elena Novak</h3>
            <p class="team-role">Head of Design</p>
            <p class="team-bio">
              Elena crafts every pixel of the Connectly experience. She believes
              great design is invisible &mdash; it just feels right.
            </p>
          </div>
          <div class="team-member">
            <div class="team-avatar post-avatar-5">DP</div>
            <h3>David Park</h3>
            <p class="team-role">Head of Community</p>
            <p class="team-bio">
              David works to keep Connectly a safe and welcoming space for
              everyone. He's your go-to person for community guidelines and
              support.
            </p>
          </div>
        </div>
      </section>
    </main>

    <!-- ===== Footer ===== -->
    {{>footer}}

    <script src="js/main.js"></script>
  </body>
</html>
